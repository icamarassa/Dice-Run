[gd_resource type="Resource" script_class="ClasseJogador" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/classe_jogador.gd" id="1_classe"]

[resource]
script = ExtResource("1_classe")
id = "ladino"
nome = "Ladino"
descricao = "Ágil e imprevisível. Escapa das armadilhas e dá segunda chance aos dados, mas aguenta pouco."
