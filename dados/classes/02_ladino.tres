vida_inicial = 9
armadura_inicial = 0
resist_veneno = 0.0
resist_fogo = 0.0
dado_inicial = 3
rerrola_inicial = 1
passiva = "esquiva,pes_leves"
passiva_descricao = "Esquiva: 40% de evitar espinhos e fogo. Pés Leves: espinhos não ferem se você só passa. Rerrola o dado se tirar 1."
id_habilidade = "impulso"
nome_habilidade = "Impulso"
descricao_habilidade = "Sua próxima jogada anda +2 casas."
usos_habilidade = 1
custo_desbloqueio = 300
